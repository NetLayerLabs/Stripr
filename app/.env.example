# Network shown on first visit: mainnet-beta or devnet. Visitors can switch in the header.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Browser RPC per network. Devnet defaults to the public RPC. Mainnet's public RPC blocks
# browser requests, so without NEXT_PUBLIC_MAINNET_RPC_URL the app proxies it through /api/rpc.
# NEXT_PUBLIC_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=<key>
# NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<key>

# Server-side RPC for API routes (market history, RPC proxy, faucet). A dedicated key
# avoids public rate limits when loading market history.
# DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=<key>
# MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<key>

# Optional devnet faucet: the secret key (JSON byte array, e.g. the contents of
# ~/.config/solana/id.json) of the wallet that ran the seed scripts.
# FAUCET_SECRET_KEY=[12,34,...]

# Reference stock prices: Jupiter's public price API prices every xStock (no key).
# With a Pyth key, each stock Pyth has entitled for that key is priced from Pyth's equity
# feed instead, and the page shows the xStock's own on-chain price beside it. Feeds are
# requested one at a time, so a key covering only some stocks (the free trial covers TSLA
# and QQQ) still works for those. Keys: https://pythdata.app ("View your API key").
# Server-side only: never prefix this NEXT_PUBLIC_.
# PYTH_API_KEY=
